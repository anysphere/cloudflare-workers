// Cursor self-hosted pool workers on Cloudflare Containers.
//
// A cron run every five minutes lists and SSE-watches pending requests for
// CURSOR_POOL, claims them, and starts one guest container per claim.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cursor-pool-workers",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-01",
	"observability": {
		"enabled": true
	},
	"triggers": {
		// Each run holds the SSE stream for CONTROLLER_RUN_BUDGET_MS (~4m50s),
		// so back-to-back runs give continuous coverage.
		"crons": ["*/5 * * * *"]
	},
	"containers": [
		{
			"class_name": "CursorPoolWorker",
			"image": "./container/Dockerfile",
			// Upper bound on concurrently running guest containers.
			"max_instances": 10,
			// "standard-1" = 1/2 vCPU, 4 GiB memory, 8 GB disk. Agents doing real
			// builds may want a larger instance type (standard-2/-3/-4).
			"instance_type": "standard-1"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "POOL_WORKER",
				"class_name": "CursorPoolWorker"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"PoolScheduler",
				"CursorPoolWorker"
			]
		},
		{
			"tag": "v2",
			"deleted_classes": [
				"PoolScheduler"
			]
		}
	],
	// Post-clone repo snapshots live here so container boots skip full clones.
	"r2_buckets": [
		{
			"binding": "REPO_SNAPSHOTS",
			"bucket_name": "cursor-pool-worker-snapshots"
		},
		{
			"bucket_name": "cursor-pool-worker-snapshots",
			"binding": "cursor_pool_worker_snapshots",
			"remote": true
		}
	],
	"vars": {
		// Pool this Worker claims from. Must match the pool picked in the dashboard.
		"CURSOR_POOL": "default",
		// Endpoint the in-container guest CLI connects to (agent/bridge).
		// Leave unset to use the CLI default. Not the fleet API.
		"CURSOR_AGENT_ENDPOINT": "https://api2.cursor.sh",
		// Seconds an idle claimed worker stays connected before exiting.
		"WORKER_IDLE_RELEASE_TIMEOUT_SECONDS": "300",
		// Snapshots older than this are rebuilt from a fresh clone.
		"SNAPSHOT_MAX_AGE_SECONDS": "604800"
	}
	// Required secret (set with `wrangler secret put <NAME>`):
	//   CURSOR_API_KEY        Team service-account key (claims + guests).
	// Optional secrets:
	//   GIT_USERNAME          Username for cloning private repos over HTTPS
	//                         (e.g. "x-access-token" for GitHub PATs).
	//   GIT_TOKEN             Token/password for cloning private repos.
	//   SNAPSHOT_AUTH_TOKEN   Bearer token for the container<->Worker snapshot
	//                         routes. Unset disables the snapshot cache.
	// Optional vars:
	//   WORKER_PUBLIC_URL     Public URL of this Worker; with SNAPSHOT_AUTH_TOKEN
	//                         it enables the snapshot cache for repo-bound boots.
	//   CURSOR_API_URL        Fleet API base. Default https://api.cursor.com.
}
