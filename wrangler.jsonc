// Cursor self-hosted pool workers on Cloudflare Containers.
//
// This Worker does not poll Cursor. `agent worker controller --spawn` claims
// work and POSTs /spawn; each call starts one container that runs
// `cursor-agent worker start --pool`.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cursor-pool-workers",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-01",
	"observability": {
		"enabled": true
	},
	"containers": [
		{
			"class_name": "CursorPoolWorker",
			"image": "./container/Dockerfile",
			// Upper bound on concurrently running containers.
			"max_instances": 10,
			// "standard-1" = 1/2 vCPU, 4 GiB memory, 8 GB disk. Agents doing real
			// builds may want a larger instance type (standard-2/-3/-4).
			"instance_type": "standard-1"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "POOL_WORKER",
				"class_name": "CursorPoolWorker"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"PoolScheduler",
				"CursorPoolWorker"
			]
		},
		{
			"tag": "v2",
			"deleted_classes": [
				"PoolScheduler"
			]
		}
	],
	// Post-clone repo snapshots live here so container boots skip full clones.
	"r2_buckets": [
		{
			"binding": "REPO_SNAPSHOTS",
			"bucket_name": "cursor-pool-worker-snapshots"
		},
		{
			"bucket_name": "cursor-pool-worker-snapshots",
			"binding": "cursor_pool_worker_snapshots",
			"remote": true
		}
	],
	"vars": {
		// Endpoint the in-container CLI connects to (agent/bridge). Leave unset
		// to use the CLI default. This is not the fleet API (api.cursor.com).
		"CURSOR_AGENT_ENDPOINT": "https://api2.cursor.sh",
		// Seconds an idle claimed worker stays connected before exiting.
		"WORKER_IDLE_RELEASE_TIMEOUT_SECONDS": "300",
		// Snapshots older than this are rebuilt from a fresh clone.
		"SNAPSHOT_MAX_AGE_SECONDS": "604800"
	}
	// Required secrets (set with `wrangler secret put <NAME>`):
	//   SPAWN_TOKEN           Bearer token for POST /spawn (spawn.sh).
	// Optional secrets:
	//   GIT_USERNAME          Username for cloning private repos over HTTPS
	//                         (e.g. "x-access-token" for GitHub PATs).
	//   GIT_TOKEN             Token/password for cloning private repos.
	//   SNAPSHOT_AUTH_TOKEN   Bearer token for the container<->Worker snapshot
	//                         routes. Defaults to SPAWN_TOKEN when unset.
	// Optional vars:
	//   WORKER_PUBLIC_URL     Public URL of this Worker; enables snapshot cache.
}
